# Обязательно сгенерировать: python3 -c "import secrets; print(secrets.token_urlsafe(64))".
SECRET_KEY=change-me-to-a-unique-64-char-secret
DEBUG=False

# Через запятую, без пробелов. Для кириллистического домена - только punycode.
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.example

# Домен без схемы и слэша. Для кириллистического домена - только punycode.
DOMAIN=your-domain.example

# Только схема + хост, без слеша на конце. CSRF_TRUSTED_ORIGINS строится из этого значения.
CORS_ALLOWED_ORIGINS=https://your-domain.example

POSTGRES_DB=example_name_db
POSTGRES_USER=example_name_user
POSTGRES_PASSWORD=strong_password_here
DB_HOST=db
DB_PORT=5432

# True - Django на SQLite вместо Postgres для локальной отладки.
USE_SQLITE=False